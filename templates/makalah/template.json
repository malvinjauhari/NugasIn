{
  "name": "makalah",
  "display_name": "Makalah Akademik",
  "description": "Template untuk makalah akademik / MKDU",
  "version": "1.0.0",
  "page": {
    "paper": "a4",
    "orientation": "portrait",
    "margins": {
      "left": 4.0,
      "top": 3.0,
      "right": 3.0,
      "bottom": 3.0
    }
  },
  "styles": {
    "body": {
      "font": {
        "name": "Times New Roman",
        "size": 12
      },
      "alignment": "justify",
      "line_spacing": 1.5,
      "first_line_indent_cm": 1.27
    },
    "headings": [
      {
        "level": 1,
        "font": {
          "name": "Times New Roman",
          "size": 14,
          "bold": true
        },
        "alignment": "center",
        "space_before_pt": 24,
        "space_after_pt": 12
      },
      {
        "level": 2,
        "font": {
          "name": "Times New Roman",
          "size": 12,
          "bold": true
        },
        "alignment": "left",
        "space_before_pt": 12,
        "space_after_pt": 6
      }
    ],
    "cover": {
      "title_font": {
        "name": "Times New Roman",
        "size": 14,
        "bold": true
      },
      "logo_width_cm": 5.0,
      "logo_height_cm": 5.0,
      "logo_alignment": "center"
    }
  },
  "page_numbering": {
    "front_matter": {
      "format": "lower_roman",
      "position": "bottom-center"
    },
    "main_content": {
      "format": "decimal",
      "position": "bottom-center"
    }
  },
  "structure": [
    {
      "title": "Cover",
      "type": "cover"
    },
    {
      "title": "Kata Pengantar",
      "type": "front_matter",
      "elements": [
        {
          "type": "heading",
          "level": 1,
          "text": "KATA PENGANTAR"
        },
        {
          "type": "paragraph",
          "text": "Puji syukur kami panjatkan ke hadirat Tuhan Yang Maha Esa..."
        }
      ]
    },
    {
      "title": "Daftar Isi",
      "type": "front_matter",
      "elements": [
        {
          "type": "heading",
          "level": 1,
          "text": "DAFTAR ISI"
        }
      ]
    },
    {
      "title": "Daftar Gambar",
      "type": "front_matter",
      "elements": [
        {
          "type": "heading",
          "level": 1,
          "text": "DAFTAR GAMBAR"
        }
      ]
    },
    {
      "title": "Daftar Tabel",
      "type": "front_matter",
      "elements": [
        {
          "type": "heading",
          "level": 1,
          "text": "DAFTAR TABEL"
        }
      ]
    },
    {
      "title": "BAB I PENDAHULUAN",
      "type": "chapter",
      "heading_level": 1,
      "numbering": "BAB I",
      "elements": [
        {
          "type": "heading",
          "level": 2,
          "text": "1.1 Latar Belakang",
          "numbering": "1.1"
        },
        {
          "type": "heading",
          "level": 2,
          "text": "1.2 Rumusan Masalah",
          "numbering": "1.2"
        },
        {
          "type": "heading",
          "level": 2,
          "text": "1.3 Tujuan Penulisan",
          "numbering": "1.3"
        }
      ]
    },
    {
      "title": "BAB II PEMBAHASAN",
      "type": "chapter",
      "heading_level": 1,
      "numbering": "BAB II",
      "elements": [
        {
          "type": "heading",
          "level": 2,
          "text": "2.1 Kajian Teori",
          "numbering": "2.1"
        },
        {
          "type": "heading",
          "level": 2,
          "text": "2.2 Analisis Masalah",
          "numbering": "2.2"
        }
      ]
    },
    {
      "title": "BAB III PENUTUP",
      "type": "chapter",
      "heading_level": 1,
      "numbering": "BAB III",
      "elements": [
        {
          "type": "heading",
          "level": 2,
          "text": "3.1 Kesimpulan",
          "numbering": "3.1"
        },
        {
          "type": "heading",
          "level": 2,
          "text": "3.2 Saran",
          "numbering": "3.2"
        }
      ]
    },
    {
      "title": "Daftar Pustaka",
      "type": "references",
      "elements": [
        {
          "type": "heading",
          "level": 1,
          "text": "DAFTAR PUSTAKA"
        }
      ]
    }
  ],
  "metadata_fields": [
    {"key": "title", "label": "Judul Makalah", "type": "text", "required": true},
    {"key": "author", "label": "Nama Mahasiswa", "type": "text", "required": true},
    {"key": "nim", "label": "NIM", "type": "text", "required": true},
    {"key": "class_name", "label": "Kelas", "type": "text", "required": false},
    {"key": "lecturer", "label": "Dosen Pengampu", "type": "text", "required": true},
    {"key": "program", "label": "Program Studi", "type": "text", "required": false},
    {"key": "faculty", "label": "Fakultas", "type": "text", "required": false},
    {"key": "institution", "label": "Universitas", "type": "text", "required": false, "default": "Telkom University"},
    {"key": "year", "label": "Tahun", "type": "number", "required": false, "default": 2026}
  ]
}
